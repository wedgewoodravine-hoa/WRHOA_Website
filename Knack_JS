/* This Code Checks All the Boxes in the Checkbox We Made For That Form Only */
$(document).on('knack-view-render.view_532', function(event, view) { 
  $('#view_532 .conn_inputs input').each(function() {
    $('#view_532 .conn_inputs input').prop('checked', true); 
  });
});

/* Auto-click verify-account control when present (safe if that page is not loaded). */
function clickVerifyAccountIfPresent() {
  var verifyBtn = document.getElementById("Click Here to Verify Account Information");
  if (verifyBtn) {
    verifyBtn.click();
  }
}

clickVerifyAccountIfPresent();
$(document).on("knack-scene-render", clickVerifyAccountIfPresent);

